# Application environment. Copy to deploy/app.env on the production host.
SQL_DSN=postgresql://root:replace-with-existing-postgres-password@postgres:5432/new-api
REDIS_CONN_STRING=redis://:replace-with-existing-redis-password@redis:6379
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=dawn-router-node-1

# Preserve these values from the old deployment. Changing SESSION_SECRET logs users out.
SESSION_SECRET=replace-with-existing-session-secret
# CRYPTO_SECRET=replace-with-existing-crypto-secret

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://your-public-domain.example
# Replace with the actual IP/CIDR seen by the application for the reverse proxy.
TRUSTED_PROXIES=127.0.0.1
