# Compose interpolation settings. Keep this file private on the production host.
IMAGE_REPOSITORY=ghcr.io/ymngkhtd/dawn-router
IMAGE_TAG=sha-replace-with-a-published-commit
APP_PORT=13500

# These values must match the existing PostgreSQL cluster and its Compose volume.
POSTGRES_USER=root
POSTGRES_DB=new-api
POSTGRES_PASSWORD=replace-with-existing-postgres-password

# Redis is a cache/session dependency. Keep the password aligned with app.env.
REDIS_PASSWORD=replace-with-existing-redis-password
